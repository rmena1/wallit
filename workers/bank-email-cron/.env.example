# Required - Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Required - Gmail IMAP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Required - Wallit Import API
WALLIT_BASE_URL=https://your-wallit-instance.railway.app
WALLIT_IMPORT_TOKEN=your-import-bearer-token
WALLIT_USER_ID=your-wallit-user-id

# Required - TypeSafe (Jev) API
TYPESAFE_API_KEY=apikey_your_typesafe_key

# Required - Account IDs (from Wallit)
ACCOUNT_BCI_CLP_ID=m3p73v3hx022lsy8z5w39
ACCOUNT_BCI_USD_ID=2fy0igbyfngwuw9s7rye2
ACCOUNT_TENPO_CREDIT_ID=33hmwmu5ppq3avb5756u2
ACCOUNT_TENPO_VISTA_ID=nxk4kf3fka5r8a3ozqtks
ACCOUNT_MERCADOPAGO_ID=f3vvmp7rra6v93ts6llfb

# Required - Exchange Rate
USD_CLP_EXCHANGE_RATE_X100=94650

# Optional - OpenAI (Luna fallback)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

# Optional - Gmail IMAP Configuration
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_TLS=true
GMAIL_IMAP_FOLDER=INBOX
GMAIL_INITIAL_UID=0
GMAIL_LOOKBACK_DAYS=30

# Optional - IMAP TLS Certificate Validation
# Set to 'false' to disable certificate validation (use only if Railway/egress presents self-signed cert)
# Default: true (secure, recommended for production)
# IMAP_TLS_REJECT_UNAUTHORIZED=false

# Optional - TypeSafe Configuration
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
JEV_TIMEOUT_MS=15000

# Optional - Luna Configuration
LUNA_TIMEOUT_MS=30000

# Optional - Category Configuration
CATEGORY_MIN_CONFIDENCE=0.70

# Optional - Import URL Override
# WALLIT_IMPORT_URL=https://custom-url/api/import/email
